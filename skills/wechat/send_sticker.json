{
  "id": "wechat.send_sticker",
  "version": 2,
  "title": "在当前会话发一个收藏表情",
  "page": "chat",
  "intent": "reply_with_sticker",
  "params": {
    "slot": {
      "type": "integer",
      "min": 1,
      "max": 8,
      "desc": "第几个「真贴纸」（跳过 + 号与微信输入法推广位）"
    }
  },
  "pre": [{ "kind": "page", "value": "chat", "message": "必须先停在会话页" }],
  "steps": [
    { "op": "act.tap", "target": { "page": "chat", "element": "emoji_panel_button" } },
    { "op": "wait.stable", "args": { "frames": 2, "timeoutMs": 8000 } },
    { "op": "act.tap", "target": { "page": "sticker_panel", "element": "tab_favorites" } },
    { "op": "wait.stable", "args": { "frames": 2, "timeoutMs": 8000 } },
    { "op": "act.tap_sticker_slot", "args": { "slot": "$slot" } },
    { "op": "wait.stable", "args": { "frames": 2, "timeoutMs": 8000 } },
    { "op": "act.close_panel" },
    { "op": "wait.stable", "args": { "frames": 2, "timeoutMs": 8000 } }
  ],
  "post": [{ "kind": "page", "value": "chat", "message": "发完不在会话页了" }],
  "budget": { "maxSteps": 12, "maxMs": 40000 },
  "idempotency": "unsafe",
  "dryRun": "supported"
}